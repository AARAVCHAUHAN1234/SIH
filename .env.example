# ==========================================
# GARUDA KAVACH ENVIRONMENT
# ==========================================

# Application
APP_NAME=Garuda Kavach
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173

# PostgreSQL
POSTGRES_USER=garuda
POSTGRES_PASSWORD=garuda_dev_password
POSTGRES_DB=garuda_kavach
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL
DATABASE_URL=postgresql+psycopg://garuda:garuda_dev_password@postgres:5432/garuda_kavach

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Storage
STORAGE_BACKEND=local
STORAGE_ROOT=/app/data

# Upload limits
MAX_UPLOAD_SIZE_MB=500

# AI
AI_DEVICE=cpu
AI_CONFIDENCE_THRESHOLD=0.40

# Reconstruction
RECONSTRUCTION_ENABLED=true

# CORS
CORS_ORIGINS=http://localhost:5173